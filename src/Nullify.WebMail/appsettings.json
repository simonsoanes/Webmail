{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": ""
  },
  "PublicUrl": "",
  "Imap": {
    "Host": "",
    "Port": 993,
    "Security": "Tls",
    "AllowInvalidCertificates": false
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls"
  },
  "Sieve": {
    "Host": "",
    "Port": 4190
  },
  "CalDav": {
    "Url": ""
  },
  "CardDav": {
    "Url": ""
  },
  "ConnectionPool": {
    "Size": 3,
    "IdleMinutes": 5
  },
  "ReverseProxy": {
    "Enabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  }
}