@using Nullify.WebMail.Services
@inject ApiService Api
@inject AppState State
@inject MailActions Actions
@implements IDisposable

@{
    var folder = State.Folders.FirstOrDefault(f => f.Name == State.SelectedFolder);
    var title = folder != null ? MailFormat.FolderLeaf(folder) : State.SelectedFolder ?? "Mail";
    var messages = State.CurrentMessages;
    var checkedCount = State.CheckedUids.Count;
    var allChecked = messages.Count > 0 && messages.All(m => State.CheckedUids.Contains(m.Uid));
    var isSentLike = folder?.SpecialUse is "Sent" or "Drafts";
}

<div class="list-header">
    <div class="list-title">
        <button class="icon-btn show-menu" style="display:none;" @onclick="OnMenu" title="Menu"><Icon Name="menu" /></button>
        <h2>@(State.IsSearching ? "Search results" : title)</h2>
        @if (!State.IsSearching && folder is { UnreadMessages: > 0 })
        {
            <span class="sub">@folder.UnreadMessages unread</span>
        }
        <span class="spacer"></span>
        <button class="icon-btn" @onclick="Reload" title="Refresh" disabled="@loading">
            <Icon Name="refresh" Size="17" Class="@(loading ? "spin" : null)" />
        </button>
    </div>
    <div class="list-search">
        <Icon Name="search" Size="16" />
        <input @bind="searchQuery" @bind:event="oninput" @onkeydown="OnSearchKey"
               placeholder="Search @title" aria-label="Search messages" />
        @if (State.IsSearching || searchQuery.Length > 0)
        {
            <button class="icon-btn small clear" @onclick="ClearSearch" title="Clear search"><Icon Name="x" Size="15" /></button>
        }
    </div>
</div>

<div class="list-toolbar">
    <input type="checkbox" checked="@allChecked" @onchange="ToggleAll" title="Select all" aria-label="Select all"
           disabled="@(messages.Count == 0)" />
    @if (checkedCount > 0)
    {
        <span class="sel-count">@checkedCount selected</span>
        <span class="spacer"></span>
        <button class="icon-btn" title="Mark as read" @onclick="() => Bulk(u => Actions.SetSeenAsync(u, true))"><Icon Name="mail-open" Size="17" /></button>
        <button class="icon-btn" title="Mark as unread" @onclick="() => Bulk(u => Actions.SetSeenAsync(u, false))"><Icon Name="mail" Size="17" /></button>
        <button class="icon-btn" title="Star" @onclick="() => Bulk(u => Actions.SetFlaggedAsync(u, !AllFlagged(u)))"><Icon Name="star" Size="17" /></button>
        @if (State.TagsSupported)
        {
            <span class="menu-anchor">
                <button class="icon-btn" title="Tags" @onclick="() => bulkTagsOpen = !bulkTagsOpen" aria-haspopup="menu" aria-expanded="@bulkTagsOpen"><Icon Name="tag" Size="17" /></button>
                @if (bulkTagsOpen)
                {
                    <div class="menu-backdrop" @onclick="() => bulkTagsOpen = false"></div>
                    <div class="menu tag-menu" role="menu">
                        <TagMenu Uids="State.CheckedUids.ToList()" OnDone="() => bulkTagsOpen = false" />
                    </div>
                }
            </span>
        }
        <button class="icon-btn" title="Archive" @onclick="() => Bulk(Actions.ArchiveAsync, clear: true)"><Icon Name="archive" Size="17" /></button>
        <MoveMenu OnMove="dest => Bulk(u => Actions.MoveAsync(u, dest), clear: true)" />
        <button class="icon-btn" title="Delete" @onclick="() => Bulk(Actions.DeleteAsync, clear: true)"><Icon Name="trash" Size="17" /></button>
    }
    else
    {
        <span class="spacer"></span>
        @if (!State.IsSearching && State.CurrentTotal > 0)
        {
            <span class="pager">
                @(State.CurrentPage * PageSize + 1)–@Math.Min((State.CurrentPage + 1) * PageSize, State.CurrentTotal) of @State.CurrentTotal.ToString("N0")
                <button class="icon-btn small" @onclick="PrevPage" disabled="@(State.CurrentPage == 0)" title="Newer"><Icon Name="chevron-left" Size="16" /></button>
                <button class="icon-btn small" @onclick="NextPage" disabled="@((State.CurrentPage + 1) * PageSize >= State.CurrentTotal)" title="Older"><Icon Name="chevron-right" Size="16" /></button>
            </span>
        }
        else if (State.IsSearching)
        {
            <span class="pager">@messages.Count result@(messages.Count == 1 ? "" : "s")</span>
        }
    }
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div style="padding:.75rem 1rem 0;">
        <div class="alert err"><Icon Name="alert" Size="15" /><div>Could not load messages: @loadError</div></div>
        <button class="btn small" @onclick="Reload">Retry</button>
    </div>
}

<div class="message-list @(checkedCount > 0 ? "selecting" : "")">
    @if (loading && showSkeleton)
    {
        @for (var i = 0; i < 9; i++)
        {
            <div class="skeleton-row">
                <div class="skeleton circle"></div>
                <div>
                    <div class="skeleton line" style="width:@(40 + i * 37 % 35)%;"></div>
                    <div class="skeleton line" style="width:@(60 + i * 23 % 30)%;"></div>
                </div>
            </div>
        }
    }
    else if (messages.Count == 0 && loadError == null)
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="@(State.IsSearching ? "search" : "inbox")" Size="26" /></div>
            <h3>@(State.IsSearching ? "No matches" : "Nothing here")</h3>
            <p>@(State.IsSearching ? $"No messages in {title} match \"{searchQuery}\"." : $"{title} is empty.")</p>
        </div>
    }
    else
    {
        @foreach (var msg in messages)
        {
            var m = msg;
            var who = MailFormat.ParseAddress(isSentLike ? FirstRecipient(m.To) : m.From);
            var isChecked = State.CheckedUids.Contains(m.Uid);
            <div class="msg-row @(State.SelectedMessageUid == m.Uid ? "active" : "") @(m.IsSeen ? "" : "unread") @(isChecked ? "checked" : "") @(ctxAt != null && ctxUids.Contains(m.Uid) ? "context" : "")"
                 draggable="true" @ondragstart="() => DragStart(m.Uid)"
                 @onclick="e => RowClick(e, m.Uid)"
                 @oncontextmenu="e => OpenContext(e, m.Uid)" @oncontextmenu:preventDefault="true">
                <div class="lead" @onclick:stopPropagation="true">
                    <div class="avatar" style="--hue:@MailFormat.AvatarHue(who)">@MailFormat.Initials(who)</div>
                    <input type="checkbox" checked="@isChecked" @onchange="() => ToggleCheck(m.Uid)" aria-label="Select message" />
                </div>
                <div class="msg-main">
                    <div class="msg-line">
                        <span class="msg-from" title="@who">@(isSentLike ? "To: " : "")@(who.Display.Length > 0 ? who.Display : "(unknown)")</span>
                        <span class="msg-date" title="@MailFormat.FullDate(m.Date, State.TimeZone)">@MailFormat.ListDate(m.Date, State.TimeZone)</span>
                    </div>
                    <div class="msg-line">
                        @if (m.IsDraft) { <span class="tag draft">Draft</span> }
                        @{ var tags = MailTags.Tags(m.Keywords).ToList(); }
                        @foreach (var t in tags.Take(2))
                        {
                            <span class="tag-chip" style="--tag:@MailTags.Color(t)" title="@MailTags.Label(t)">@MailTags.Label(t)</span>
                        }
                        @if (tags.Count > 2)
                        {
                            <span class="tag-chip more" title="@string.Join(", ", tags.Skip(2).Select(MailTags.Label))">+@(tags.Count - 2)</span>
                        }
                        <span class="msg-subject">@(string.IsNullOrWhiteSpace(m.Subject) ? "(no subject)" : m.Subject)</span>
                        <span class="msg-badges">
                            @if (m.IsImportant) { <span class="important" title="Important"><Icon Name="important" Size="13" /></span> }
                            @if (m.IsAnswered) { <span title="Replied"><Icon Name="reply" Size="13" /></span> }
                            @if (m.HasAttachments) { <span title="Has attachments"><Icon Name="paperclip" Size="13" /></span> }
                            <button class="icon-btn star @(m.IsFlagged ? "on" : "")" title="@(m.IsFlagged ? "Unstar" : "Star")"
                                    @onclick="() => Actions.ToggleFlaggedAsync(m.Uid)" @onclick:stopPropagation="true">
                                <Icon Name="star" Size="15" Filled="m.IsFlagged" />
                            </button>
                        </span>
                    </div>
                </div>
                <div class="msg-hover-actions" @onclick:stopPropagation="true">
                    <button class="icon-btn" title="Archive" @onclick="() => Actions.ArchiveAsync([m.Uid])"><Icon Name="archive" Size="16" /></button>
                    <button class="icon-btn" title="@(m.IsSeen ? "Mark as unread" : "Mark as read")" @onclick="() => Actions.SetSeenAsync([m.Uid], !m.IsSeen)">
                        <Icon Name="@(m.IsSeen ? "mail" : "mail-open")" Size="16" />
                    </button>
                    <button class="icon-btn" title="Delete" @onclick="() => Actions.DeleteAsync([m.Uid])"><Icon Name="trash" Size="16" /></button>
                </div>
            </div>
        }
    }
</div>

@if (ctxAt is { } at)
{
    var targets = ctxUids;
    var single = targets.Count == 1 ? Actions.Find(targets.First()) : null;
    var anyUnread = targets.Any(u => Actions.Find(u) is { IsSeen: false });
    var flagged = AllFlagged(targets);
    var junk = State.FindSpecialFolder("Junk");
    <ContextMenu X="at.X" Y="at.Y" OnClose="CloseContext">
        @if (ctxView == "move")
        {
            <button class="menu-item" @onclick='() => ctxView = "main"'><Icon Name="chevron-left" Size="16" /> <span>Move to</span></button>
            <div class="menu-sep"></div>
            <div class="menu-scroll">
                @foreach (var f in State.OrderedFolders().Where(f => f.Name != State.SelectedFolder))
                {
                    var dest = f.Name;
                    <button class="menu-item" style="padding-left:@(0.6 + MailFormat.FolderDepth(f) * 0.9)rem;"
                            @onclick="() => FromContext(u => Actions.MoveAsync(u, dest), clear: true)">
                        <Icon Name="@MailFormat.FolderIcon(f)" Size="16" /> <span>@MailFormat.FolderLeaf(f)</span>
                    </button>
                }
            </div>
        }
        else if (ctxView == "tags")
        {
            <button class="menu-item" @onclick='() => ctxView = "main"'><Icon Name="chevron-left" Size="16" /> <span>Tags</span></button>
            <div class="menu-sep"></div>
            <TagMenu Uids="targets" OnDone="CloseContext" />
        }
        else
        {
            @if (single != null)
            {
                <button class="menu-item" @onclick="() => OpenFromContext(single.Uid)"><Icon Name="mail-open" Size="16" /> <span>Open</span></button>
                <button class="menu-item" @onclick="() => ReplyFromContext(ComposeMode.Reply, single.Uid)"><Icon Name="reply" Size="16" /> <span>Reply</span></button>
                <button class="menu-item" @onclick="() => ReplyFromContext(ComposeMode.ReplyAll, single.Uid)"><Icon Name="reply-all" Size="16" /> <span>Reply all</span></button>
                <button class="menu-item" @onclick="() => ReplyFromContext(ComposeMode.Forward, single.Uid)"><Icon Name="forward" Size="16" /> <span>Forward</span></button>
            }
            else
            {
                <div class="menu-title">@targets.Count messages</div>
            }
            <div class="menu-sep"></div>
            <button class="menu-item" @onclick="() => FromContext(u => Actions.SetSeenAsync(u, anyUnread))">
                <Icon Name="@(anyUnread ? "mail-open" : "mail")" Size="16" /> <span>@(anyUnread ? "Mark as read" : "Mark as unread")</span>
            </button>
            <button class="menu-item" @onclick="() => FromContext(u => Actions.SetFlaggedAsync(u, !flagged))">
                <Icon Name="star" Size="16" Filled="flagged" /> <span>@(flagged ? "Remove star" : "Star")</span>
            </button>
            @if (State.TagsSupported)
            {
                <button class="menu-item" @onclick='() => ctxView = "tags"'><Icon Name="tag" Size="16" /> <span>Tags</span><span class="spacer"></span><Icon Name="chevron-right" Size="14" /></button>
            }
            <div class="menu-sep"></div>
            <button class="menu-item" @onclick='() => ctxView = "move"'><Icon Name="folder-input" Size="16" /> <span>Move to</span><span class="spacer"></span><Icon Name="chevron-right" Size="14" /></button>
            <button class="menu-item" @onclick="() => FromContext(Actions.ArchiveAsync, clear: true)"><Icon Name="archive" Size="16" /> <span>Archive</span></button>
            @if (junk != null && junk.Name != State.SelectedFolder)
            {
                <button class="menu-item" @onclick="() => FromContext(Actions.JunkAsync, clear: true)"><Icon Name="alert" Size="16" /> <span>Move to Junk</span></button>
            }
            <button class="menu-item danger" @onclick="() => FromContext(Actions.DeleteAsync, clear: true)"><Icon Name="trash" Size="16" /> <span>Delete</span></button>
        }
    </ContextMenu>
}

@code {
    [Parameter] public EventCallback OnMenu { get; set; }

    private const int PageSize = 50;
    private string searchQuery = "";
    private string? loadError;
    private bool loading;
    private bool showSkeleton;
    private int loadToken;
    private bool bulkTagsOpen;

    // Shift-click selects from here: the last message clicked or ticked.
    private long? anchorUid;

    // The right-click menu: where, for which messages, and which list it shows (main, move, tags).
    private (double X, double Y)? ctxAt;
    private IReadOnlyCollection<long> ctxUids = [];
    private string ctxView = "main";

    // Only refetch when the folder or the list version actually changes — a full
    // IMAP SELECT+FETCH on every state change (e.g. each message click) is far too chatty.
    private string? loadedFolder;
    private int loadedVersion = -1;

    protected override async Task OnInitializedAsync()
    {
        State.StateChanged += OnStateChanged;
        await EnsureLoaded();
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await EnsureLoaded();
        });
    }

    private async Task EnsureLoaded()
    {
        if (State.SelectedFolder == null) return;
        if (State.SelectedFolder != loadedFolder)
        {
            // New folder: reset paging, search and selection.
            State.CurrentPage = 0;
            State.IsSearching = false;
            searchQuery = "";
            State.CheckedUids.Clear();
            await LoadMessages(skeleton: true);
        }
        else if (State.ListVersion != loadedVersion)
        {
            if (State.IsSearching) await DoSearch(quiet: true);
            else await LoadMessages(skeleton: false);
        }
    }

    private async Task LoadMessages(bool skeleton)
    {
        var folder = State.SelectedFolder;
        if (folder == null) return;
        var token = ++loadToken;
        loadedFolder = folder;
        loadedVersion = State.ListVersion;
        loading = true;
        showSkeleton = skeleton;
        loadError = null;
        if (skeleton) State.CurrentMessages = Array.Empty<MessageSummary>();
        StateHasChanged();
        try
        {
            var result = await Api.GetMessagesAsync(folder, State.CurrentPage, PageSize);
            if (token != loadToken) return; // superseded by a newer load
            if (result != null)
            {
                State.CurrentMessages = result.Messages;
                State.CurrentTotal = result.Total;
                State.FolderTags = result.Keywords?.Where(MailTags.IsTag).ToList() ?? [];
                State.CanCreateTags = result.CanCreateKeywords;
                // A page beyond the end (after deletes) snaps back.
                if (result.Messages.Count == 0 && State.CurrentPage > 0)
                {
                    State.CurrentPage--;
                    await LoadMessages(skeleton: false);
                    return;
                }
            }
            State.CheckedUids.IntersectWith(State.CurrentMessages.Select(m => m.Uid));
        }
        catch (Exception ex)
        {
            if (token != loadToken) return;
            loadError = ex.InnerException?.Message ?? ex.Message;
        }
        loading = false;
        State.NotifyStateChanged();
    }

    private void Open(long uid)
    {
        State.SelectedMessageUid = uid;
        State.ShowCompose = false;
        State.NotifyStateChanged();
    }

    /// <summary>Click opens; Ctrl/Cmd-click adds or removes one message; Shift-click selects a run.</summary>
    private void RowClick(MouseEventArgs e, long uid)
    {
        var additive = e.CtrlKey || e.MetaKey;
        if (e.ShiftKey)
        {
            var list = State.CurrentMessages.Select(m => m.Uid).ToList();
            var to = list.IndexOf(uid);
            var from = list.IndexOf(anchorUid ?? State.SelectedMessageUid ?? uid);
            if (from < 0) from = to;
            if (!additive) State.CheckedUids.Clear();
            State.CheckedUids.UnionWith(list.Skip(Math.Min(from, to)).Take(Math.Abs(to - from) + 1));
            anchorUid ??= uid;
            State.NotifyStateChanged();
            return;
        }
        if (additive)
        {
            // Starting a selection from the open message keeps it in the selection.
            if (State.CheckedUids.Count == 0 && State.SelectedMessageUid is { } open && open != uid
                && State.CurrentMessages.Any(m => m.Uid == open))
                State.CheckedUids.Add(open);
            ToggleCheck(uid);
            return;
        }
        anchorUid = uid;
        State.CheckedUids.Clear();
        Open(uid);
    }

    private void ToggleCheck(long uid)
    {
        anchorUid = uid;
        if (!State.CheckedUids.Remove(uid)) State.CheckedUids.Add(uid);
        State.NotifyStateChanged();
    }

    private bool AllFlagged(IEnumerable<long> uids) => uids.All(u => Actions.Find(u) is { IsFlagged: true });

    /// <summary>Right-click acts on the selection when the message is part of it, else on that message alone.</summary>
    private void OpenContext(MouseEventArgs e, long uid)
    {
        ctxUids = State.CheckedUids.Contains(uid) ? State.CheckedUids.ToList() : [uid];
        ctxAt = (e.ClientX, e.ClientY);
        ctxView = "main";
    }

    private void CloseContext()
    {
        ctxAt = null;
        ctxView = "main";
    }

    private async Task FromContext(Func<IReadOnlyCollection<long>, Task> action, bool clear = false)
    {
        var uids = ctxUids;
        CloseContext();
        if (clear) State.CheckedUids.ExceptWith(uids);
        await action(uids);
    }

    private void OpenFromContext(long uid)
    {
        CloseContext();
        anchorUid = uid;
        Open(uid);
    }

    private void ReplyFromContext(ComposeMode mode, long uid)
    {
        CloseContext();
        State.SelectedMessageUid = uid;
        State.StartCompose(mode, State.SelectedFolder, uid);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true) State.CheckedUids.UnionWith(State.CurrentMessages.Select(m => m.Uid));
        else State.CheckedUids.Clear();
        State.NotifyStateChanged();
    }

    private async Task Bulk(Func<IReadOnlyCollection<long>, Task> action, bool clear = false)
    {
        var uids = State.CheckedUids.ToList();
        if (clear) State.CheckedUids.Clear();
        await action(uids);
    }

    private void DragStart(long uid)
    {
        // Dragging a ticked row drags the whole selection.
        State.DraggingFolder = null;
        State.DraggingUids = State.CheckedUids.Contains(uid) ? State.CheckedUids.ToList() : [uid];
    }

    private async Task Reload()
    {
        loadedVersion = -1;
        if (State.IsSearching) await DoSearch(quiet: false);
        else await LoadMessages(skeleton: false);
        State.FoldersVersion++;
        State.NotifyStateChanged();
    }

    private async Task PrevPage()
    {
        if (State.CurrentPage == 0) return;
        State.CurrentPage--;
        State.CheckedUids.Clear();
        await LoadMessages(skeleton: true);
    }

    private async Task NextPage()
    {
        State.CurrentPage++;
        State.CheckedUids.Clear();
        await LoadMessages(skeleton: true);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch(quiet: false);
        else if (e.Key == "Escape") await ClearSearch();
    }

    private async Task DoSearch(bool quiet)
    {
        var folder = State.SelectedFolder;
        if (string.IsNullOrWhiteSpace(searchQuery) || folder == null) return;
        var token = ++loadToken;
        loadedVersion = State.ListVersion;
        loading = true;
        showSkeleton = !quiet;
        loadError = null;
        StateHasChanged();
        try
        {
            var results = await Api.SearchAsync(folder, searchQuery, 200);
            if (token != loadToken) return;
            State.CurrentMessages = results;
            State.CurrentTotal = results.Count;
            State.IsSearching = true;
            State.CheckedUids.Clear();
        }
        catch (Exception ex)
        {
            if (token != loadToken) return;
            loadError = ex.InnerException?.Message ?? ex.Message;
        }
        loading = false;
        State.NotifyStateChanged();
    }

    private async Task ClearSearch()
    {
        searchQuery = "";
        if (!State.IsSearching) return;
        State.IsSearching = false;
        State.CurrentPage = 0;
        await LoadMessages(skeleton: true);
    }

    private static string FirstRecipient(string to)
    {
        var list = MailFormat.ParseAddressList(to);
        return list.Count == 0 ? to : list.Count == 1 ? list[0].ToString() : $"{list[0].Display} +{list.Count - 1}";
    }

    public void Dispose() => State.StateChanged -= OnStateChanged;
}
