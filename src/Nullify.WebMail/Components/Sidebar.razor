@using System.Text.Json
@using Nullify.WebMail.Services
@inject UserSession UserSession
@inject ApiService Api
@inject AppState State
@inject MailActions Actions
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<div class="brand">
    <div class="brand-mark"><Icon Name="mail" Size="17" /></div>
    <div class="brand-text">@State.BrandTitle<small>WebMail</small></div>
    <span class="spacer"></span>
    <button class="icon-btn small rail-toggle" @onclick="ToggleRail" title="Collapse or expand sidebar">
        <Icon Name="sidebar" Size="16" />
    </button>
</div>

<button class="btn accent compose-btn" @onclick="Compose" title="Compose (c)"><Icon Name="pen" Size="16" /> <span class="label">Compose</span></button>

<div class="folder-list">
    <div class="nav-section">
        <div class="nav-label">
            <span>Folders</span>
            <span class="btn-group">
                <button class="icon-btn" @onclick="Refresh" title="Refresh folders"><Icon Name="refresh" Size="13" /></button>
                <button class="icon-btn" @onclick="StartNewFolder" title="New folder"><Icon Name="plus" Size="14" /></button>
            </span>
        </div>

        @if (showNewFolder && newFolderParent == null)
        {
            <div class="inline-form">
                <input @ref="newFolderInput" @bind="newFolderName" @bind:event="oninput" placeholder="Folder name"
                       @onkeydown="OnNewFolderKey" />
                <button class="btn small accent" @onclick="CreateFolder">Add</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="alert err sidebar-error">
                <Icon Name="alert" Size="15" />
                <div>Mail server unreachable.<br /><small>@loadError</small><br />
                    <button class="btn small" style="margin-top:.4rem;" @onclick="Refresh">Retry</button></div>
            </div>
        }
        else if (State.Folders.Count == 0 && loading)
        {
            @for (var i = 0; i < 5; i++)
            {
                <div class="nav-item"><div class="skeleton line" style="width:@(50 + i * 8)%;"></div></div>
            }
        }
        else
        {
            var ordered = State.OrderedFolders();
            @foreach (var folder in ordered)
            {
                var f = folder;
                var active = State.ActiveTab == "mail" && State.SelectedFolder == f.Name;
                var depth = MailFormat.FolderDepth(f);
                var dropClass = dropTarget != f.Name ? ""
                    : State.DraggingFolder is not { } dragging ? "drop-target"
                    : dragging == f.Name || !Siblings(dragging, f.Name) ? ""
                    : ordered.FindIndex(x => x.Name == dragging) < ordered.FindIndex(x => x.Name == f.Name) ? "drop-after" : "drop-before";
                @if (renaming == f.Name)
                {
                    <div class="inline-form" style="padding-left:@(0.6 + depth * 0.9)rem;">
                        <input @bind="renameValue" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, f)" />
                        <button class="btn small accent" @onclick="() => Rename(f)">Save</button>
                    </div>
                    continue;
                }
                <div class="nav-item @(active ? "active" : "") @dropClass @(ctxFolder == f.Name ? "context" : "")"
                     style="padding-left:@(0.6 + depth * 0.9)rem;" role="button" tabindex="0"
                     title="@f.Name" draggable="true"
                     @onclick="() => SelectFolder(f.Name)"
                     @onkeydown="e => OnFolderKey(e, f)"
                     @oncontextmenu="e => OpenContext(e, f.Name)" @oncontextmenu:preventDefault="true"
                     @ondragstart="() => { State.DraggingFolder = f.Name; State.DraggingUids = Array.Empty<long>(); }"
                     @ondragend="() => { State.DraggingFolder = null; dropTarget = null; }"
                     @ondragenter="() => dropTarget = f.Name"
                     @ondragleave="() => { if (dropTarget == f.Name) dropTarget = null; }"
                     @ondragover:preventDefault="true"
                     @ondrop="() => Drop(f.Name)">
                    <Icon Name="@MailFormat.FolderIcon(f)" Size="17" />
                    <span class="label">@MailFormat.FolderLeaf(f)</span>
                    @if (f.UnreadMessages > 0 && f.SpecialUse is not ("Sent" or "Trash" or "Drafts"))
                    {
                        <span class="count">@f.UnreadMessages</span>
                    }
                    else if (f.SpecialUse == "Drafts" && f.TotalMessages > 0)
                    {
                        <span class="count muted">@f.TotalMessages</span>
                    }
                    @if (f.SpecialUse == null)
                    {
                        <span class="folder-actions" @onclick:stopPropagation="true">
                            <button class="icon-btn" title="Rename" @onclick="() => StartRename(f)"><Icon Name="pen" Size="13" /></button>
                            <button class="icon-btn" title="Delete folder" @onclick="() => DeleteFolder(f)"><Icon Name="trash" Size="13" /></button>
                        </span>
                    }
                </div>
                @if (showNewFolder && newFolderParent == f.Name)
                {
                    <div class="inline-form" style="padding-left:@(0.6 + (depth + 1) * 0.9)rem;">
                        <input @ref="newFolderInput" @bind="newFolderName" @bind:event="oninput" placeholder="Subfolder name"
                               @onkeydown="OnNewFolderKey" />
                        <button class="btn small accent" @onclick="CreateFolder">Add</button>
                    </div>
                }
            }
        }
    </div>
</div>

@if (ctxAt is { } at && State.Folders.FirstOrDefault(x => x.Name == ctxFolder) is { } cf)
{
    var siblings = SiblingNames(cf.Name);
    var index = siblings.IndexOf(cf.Name);
    <ContextMenu X="at.X" Y="at.Y" OnClose="CloseContext">
        <div class="menu-title">@MailFormat.FolderLeaf(cf)</div>
        <button class="menu-item" @onclick="() => FromContext(() => SelectFolder(cf.Name))"><Icon Name="mail-open" Size="16" /> <span>Open</span></button>
        <button class="menu-item" @onclick="() => FromContext(() => Actions.MarkFolderReadAsync(cf.Name))" disabled="@(cf.UnreadMessages == 0)">
            <Icon Name="check" Size="16" /> <span>Mark all as read</span>
        </button>
        <div class="menu-sep"></div>
        <button class="menu-item" @onclick="() => FromContext(() => StartNewFolder(cf.Name))"><Icon Name="folder-plus" Size="16" /> <span>New subfolder</span></button>
        @if (cf.SpecialUse == null)
        {
            <button class="menu-item" @onclick="() => FromContext(() => { StartRename(cf); return Task.CompletedTask; })"><Icon Name="pen" Size="16" /> <span>Rename</span></button>
        }
        <button class="menu-item" @onclick="() => FromContext(() => MoveBy(cf.Name, -1))" disabled="@(index <= 0)"><Icon Name="chevron-up" Size="16" /> <span>Move up</span></button>
        <button class="menu-item" @onclick="() => FromContext(() => MoveBy(cf.Name, 1))" disabled="@(index < 0 || index >= siblings.Count - 1)"><Icon Name="chevron-down" Size="16" /> <span>Move down</span></button>
        @if (cf.SpecialUse != "Inbox")
        {
            <button class="menu-item" @onclick="() => FromContext(() => Hide(cf))"><Icon Name="eye-off" Size="16" /> <span>Hide (unsubscribe)</span></button>
        }
        @if (cf.SpecialUse == null)
        {
            <div class="menu-sep"></div>
            <button class="menu-item danger" @onclick="() => FromContext(() => DeleteFolder(cf))"><Icon Name="trash" Size="16" /> <span>Delete folder</span></button>
        }
    </ContextMenu>
}

<nav class="sidebar-nav">
    @foreach (var (tab, icon, label) in Tabs())
    {
        <button class="nav-item @(State.ActiveTab == tab ? "active" : "")" @onclick="() => SetTab(tab)" title="@label">
            <Icon Name="@icon" Size="17" />
            <span class="label">@label</span>
        </button>
    }
</nav>

<div class="user-chip">
    @{ var me = MailFormat.ParseAddress(State.Session?.Email); }
    <button class="user-link" @onclick='() => SetTab("settings")' title="Account settings">
        <span class="avatar sm" style="--hue:@MailFormat.AvatarHue(me)">@MailFormat.Initials(me)</span>
        <span class="who">
            <strong title="@State.Session?.Email">@(State.Senders.FirstOrDefault()?.Name is { Length: > 0 } name ? name : State.Session?.Email)</strong>
            <span>@(UserSession.QrSessionExpiresUtc is { } until ? $"Signed in by phone until {TimeZoneInfo.ConvertTime(until, State.TimeZone):t}" : State.IsAdmin ? "Administrator" : "Signed in")</span>
        </span>
    </button>
    <button class="icon-btn small" @onclick="Logout" title="Sign out"><Icon Name="logout" Size="16" /></button>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool loading = true;
    private string? loadError;
    private bool showNewFolder;
    private string newFolderName = "";
    private ElementReference newFolderInput;
    private string? renaming;
    private string renameValue = "";
    private string? dropTarget;
    private int loadedVersion = -1;
    // The folder a new folder goes under (null: top level).
    private string? newFolderParent;
    // The right-click menu: where, and for which folder.
    private (double X, double Y)? ctxAt;
    private string? ctxFolder;

    private IEnumerable<(string Tab, string Icon, string Label)> Tabs()
    {
        yield return ("mail", "mail", "Mail");
        yield return ("calendar", "calendar", "Calendar");
        yield return ("tasks", "tasks", "Tasks");
        yield return ("contacts", "users", "Contacts");
        yield return ("notes", "notebook", "Notes");
        if (State.DocumentsAvailable) yield return ("documents", "hard-drive", "Documents");
        yield return ("settings", "settings", "Settings");
        if (State.IsAdmin) yield return ("admin", "shield", "Admin");
    }

    protected override async Task OnInitializedAsync()
    {
        State.StateChanged += OnStateChanged;
        await Refresh();
    }

    private async void OnStateChanged() => await InvokeAsync(async () =>
    {
        if (State.FoldersVersion != loadedVersion) await Refresh();
        StateHasChanged();
    });

    private async Task Refresh()
    {
        loadedVersion = State.FoldersVersion;
        loading = true;
        try
        {
            State.Folders = await Api.GetFoldersAsync();
            loadError = null;
        }
        catch (Exception ex)
        {
            loadError = ex.InnerException?.Message ?? ex.Message;
        }
        loading = false;
        StateHasChanged();
    }

    private async Task SelectFolder(string name)
    {
        State.ActiveTab = "mail";
        State.SelectedFolder = name;
        State.SelectedMessageUid = null;
        State.ShowCompose = false;
        State.CheckedUids.Clear();
        State.NotifyStateChanged();
        await OnNavigate.InvokeAsync();
    }

    private async Task SetTab(string tab)
    {
        State.ActiveTab = tab;
        State.ShowCompose = false;
        if (tab != "mail") State.SelectedMessageUid = null;
        State.NotifyStateChanged();
        await OnNavigate.InvokeAsync();
    }

    private async Task Compose()
    {
        State.ActiveTab = "mail";
        State.StartCompose(ComposeMode.New);
        await OnNavigate.InvokeAsync();
    }

    private async Task Drop(string folder)
    {
        dropTarget = null;
        if (State.DraggingFolder is { } dragged)
        {
            State.DraggingFolder = null;
            var ordered = State.OrderedFolders();
            var after = ordered.FindIndex(f => f.Name == dragged) < ordered.FindIndex(f => f.Name == folder);
            await Reorder(dragged, folder, after);
            return;
        }
        var uids = State.DraggingUids;
        State.DraggingUids = Array.Empty<long>();
        if (uids.Count == 0 || folder == State.SelectedFolder) return;
        State.CheckedUids.Clear();
        await Actions.MoveAsync(uids, folder);
    }

    // ---- folder order ----

    private List<string> SiblingNames(string name)
    {
        var names = State.Folders.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
        var folder = State.Folders.FirstOrDefault(f => f.Name == name);
        if (folder == null) return [];
        var parent = MailFormat.ParentOf(folder, names);
        return State.OrderedFolders().Where(f => MailFormat.ParentOf(f, names) == parent).Select(f => f.Name).ToList();
    }

    private bool Siblings(string a, string b) => SiblingNames(a).Contains(b);

    private async Task Reorder(string dragged, string target, bool after)
    {
        var order = MailFormat.MoveFolder(State.Folders, State.FolderOrder, dragged, target, after);
        if (order == null)
        {
            if (dragged != target) State.ShowToast("Folders can be re-ordered only among folders at the same level.", isError: true);
            return;
        }
        State.FolderOrder = order;
        State.NotifyStateChanged();
        try { await Api.SetPreferenceAsync(AppState.FolderOrderKey, JsonSerializer.Serialize(order)); }
        catch (Exception ex) { State.ShowToast($"Could not save the folder order: {ex.Message}", isError: true); }
    }

    private async Task MoveBy(string name, int offset)
    {
        var siblings = SiblingNames(name);
        var index = siblings.IndexOf(name);
        var target = index + offset;
        if (index < 0 || target < 0 || target >= siblings.Count) return;
        await Reorder(name, siblings[target], after: offset > 0);
    }

    private async Task OnFolderKey(KeyboardEventArgs e, FolderInfo f)
    {
        if (e.Key == "Enter") await SelectFolder(f.Name);
        else if (e.AltKey && e.Key is "ArrowUp" or "ArrowDown") await MoveBy(f.Name, e.Key == "ArrowUp" ? -1 : 1);
    }

    // ---- context menu ----

    private void OpenContext(MouseEventArgs e, string folder)
    {
        ctxFolder = folder;
        ctxAt = (e.ClientX, e.ClientY);
    }

    private void CloseContext()
    {
        ctxAt = null;
        ctxFolder = null;
    }

    private async Task FromContext(Func<Task> action)
    {
        CloseContext();
        await action();
    }

    private async Task Hide(FolderInfo f)
    {
        try
        {
            await Api.SetFolderShownAsync(f.Name, false);
            State.ShowToast($"\"{MailFormat.FolderLeaf(f)}\" hidden. Show it again from Settings › Folders.");
            if (State.SelectedFolder == f.Name)
            {
                State.SelectedFolder = "INBOX";
                State.SelectedMessageUid = null;
            }
            await Refresh();
            State.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            State.ShowToast($"Could not hide the folder: {ex.InnerException?.Message ?? ex.Message}", isError: true);
        }
    }

    // ---- folder management ----

    private async Task StartNewFolder() => await StartNewFolder(null);

    private async Task StartNewFolder(string? parent)
    {
        showNewFolder = parent != null || !showNewFolder || newFolderParent != null;
        newFolderParent = parent;
        if (showNewFolder)
        {
            StateHasChanged();
            await Task.Yield();
            try { await newFolderInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnNewFolderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateFolder();
        else if (e.Key == "Escape") showNewFolder = false;
    }

    private async Task CreateFolder()
    {
        var leaf = newFolderName.Trim();
        if (leaf.Length == 0) return;
        var parent = newFolderParent == null ? null : State.Folders.FirstOrDefault(f => f.Name == newFolderParent);
        var name = parent is { Delimiter.Length: > 0 } ? parent.Name + parent.Delimiter + leaf : leaf;
        try
        {
            await Api.CreateFolderAsync(name);
            State.ShowToast($"Folder \"{leaf}\" created");
            newFolderName = "";
            showNewFolder = false;
            newFolderParent = null;
            await Refresh();
        }
        catch (Exception ex)
        {
            State.ShowToast($"Could not create folder: {ex.InnerException?.Message ?? ex.Message}", isError: true);
        }
    }

    private void StartRename(FolderInfo f)
    {
        renaming = f.Name;
        renameValue = MailFormat.FolderLeaf(f);
    }

    private async Task OnRenameKey(KeyboardEventArgs e, FolderInfo f)
    {
        if (e.Key == "Enter") await Rename(f);
        else if (e.Key == "Escape") renaming = null;
    }

    private async Task Rename(FolderInfo f)
    {
        var leaf = renameValue.Trim();
        renaming = null;
        if (leaf.Length == 0 || leaf == MailFormat.FolderLeaf(f)) return;
        // Keep the folder under the same parent.
        var cut = string.IsNullOrEmpty(f.Delimiter) ? -1 : f.Name.LastIndexOf(f.Delimiter[0]);
        var newName = cut < 0 ? leaf : f.Name[..(cut + 1)] + leaf;
        try
        {
            await Api.RenameFolderAsync(f.Name, newName);
            if (State.SelectedFolder == f.Name) State.SelectedFolder = newName;
            State.ShowToast($"Renamed to \"{leaf}\"");
            await Refresh();
        }
        catch (Exception ex)
        {
            State.ShowToast($"Rename failed: {ex.InnerException?.Message ?? ex.Message}", isError: true);
        }
    }

    private async Task DeleteFolder(FolderInfo f)
    {
        var label = MailFormat.FolderLeaf(f);
        var warning = f.TotalMessages > 0 ? $" and its {f.TotalMessages} message(s)" : "";
        if (!await JS.InvokeAsync<bool>("nullifyApp.confirm", $"Delete the folder \"{label}\"{warning}? This cannot be undone.")) return;
        try
        {
            await Api.DeleteFolderAsync(f.Name);
            if (State.SelectedFolder == f.Name)
            {
                State.SelectedFolder = "INBOX";
                State.SelectedMessageUid = null;
            }
            State.ShowToast($"Folder \"{label}\" deleted");
            await Refresh();
            State.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            State.ShowToast($"Could not delete folder: {ex.InnerException?.Message ?? ex.Message}", isError: true);
        }
    }

    private async Task ToggleRail()
    {
        try { await JS.InvokeVoidAsync("nullifyApp.toggleSidebar"); } catch { /* circuit gone */ }
    }

    private async Task Logout()
    {
        try
        {
            await JS.InvokeAsync<JsonElement>("nullifyAuth.postJson", "/api/auth/logout", new { });
        }
        catch { /* even if the call fails, drop the local view */ }
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose() => State.StateChanged -= OnStateChanged;
}
