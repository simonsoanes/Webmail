@using Nullify.WebMail.Services
@inject IJSRuntime JS
@inject CalDavAccountService Dav

<div class="modal-backdrop" @onclick="Cancel">
    <form class="modal event-editor" role="dialog" aria-modal="true" aria-labelledby="ee-heading"
          @onclick:stopPropagation="true" @onsubmit="Save" @onsubmit:preventDefault="true">
        <div class="modal-head">
            <h3 id="ee-heading">@(Event == null ? "New event" : "Edit event")</h3>
            <span class="spacer"></span>
            <button type="button" class="icon-btn" @onclick="Cancel" title="Close"><Icon Name="x" /></button>
        </div>

        <div class="modal-body">
            <input class="title-input" @ref="titleInput" @bind="summary" @bind:event="oninput" placeholder="Add a title" aria-label="Title" />

            @if (Event?.IsRecurring == true)
            {
                <div class="notice"><Icon Name="refresh" Size="15" /><span>This is a repeating event. Changes apply to every occurrence.</span></div>
            }

            <div class="field">
                <label for="ee-cal">Calendar</label>
                <div class="select-with-dot" style="--cal:@ColorOf(calendarId)">
                    <span class="dot"></span>
                    <select id="ee-cal" @bind="calendarId">
                        @foreach (var c in Calendars) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
            </div>

            <label class="check-row">
                <input type="checkbox" @bind="allDay" @bind:after="AllDayChanged" /> All day
            </label>

            <div class="when-grid @(allDay ? "all-day" : "")">
                <label for="ee-sd">Starts</label>
                <input id="ee-sd" type="date" @bind="startDate" @bind:after="StartChanged" />
                @if (!allDay) { <input type="time" @bind="startTime" @bind:after="StartChanged" aria-label="Start time" /> }
                <label for="ee-ed">Ends</label>
                <input id="ee-ed" type="date" @bind="endDate" @bind:after="EndChanged" />
                @if (!allDay) { <input type="time" @bind="endTime" @bind:after="EndChanged" aria-label="End time" /> }
            </div>

            <div class="field">
                <label for="ee-repeat">Repeat</label>
                <select id="ee-repeat" @bind="repeat">
                    <option value="@EventRepeat.None">Does not repeat</option>
                    <option value="@EventRepeat.Daily">Every day</option>
                    <option value="@EventRepeat.Weekly">Every week on @startDate.ToString("dddd", System.Globalization.CultureInfo.InvariantCulture)</option>
                    <option value="@EventRepeat.Monthly">Every month on day @startDate.Day</option>
                    <option value="@EventRepeat.Yearly">Every year on @startDate.ToString("d MMMM", System.Globalization.CultureInfo.InvariantCulture)</option>
                </select>
                @if (customRule)
                {
                    <span class="help">This event uses a more detailed repeat rule; it's kept unless you pick a different option.</span>
                }
            </div>

            <div class="field">
                <label for="ee-remind">Reminder</label>
                <select id="ee-remind" @bind="reminder">
                    <option value="@NoReminder">None</option>
                    @foreach (var m in ReminderChoices) { <option value="@m">@ReminderLabel(m)</option> }
                </select>
                @if (initialReminders.Count > 1 && reminder == initialReminder)
                {
                    <span class="help">This event has @initialReminders.Count reminders; they're kept unless you choose another.</span>
                }
            </div>

            <div class="field">
                <label for="ee-loc">Location</label>
                <input id="ee-loc" @bind="location" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="@(canEditGuests ? "ee-guests" : null)">Guests</label>
                @if (canEditGuests)
                {
                    <div class="guest-add">
                        <RecipientInput Id="ee-guests" @bind-Value="guestInput" Candidates="candidates" OnFirstFocus="LoadCandidates"
                                        Placeholder="Invite people by name or email" />
                        <button type="button" class="btn small" @onclick="() => AddGuests()" disabled="@string.IsNullOrWhiteSpace(guestInput)">Add</button>
                    </div>
                    @if (guestError != null) { <span class="help err" role="alert">@guestError</span> }
                }
                else if (Event?.Organizer is { } org)
                {
                    <span class="help">Organised by @org.Display. Only the organiser can change who's invited.</span>
                }
                @if (guests.Count > 0)
                {
                    <ul class="guest-list" aria-label="Guests">
                        @foreach (var g in guests)
                        {
                            var guest = g;
                            <li>
                                <GuestStatus Status="guest.Status" />
                                <span class="guest-name" title="@guest.Email">
                                    @guest.Display
                                    @if (!string.IsNullOrWhiteSpace(guest.Name)) { <span class="muted">@guest.Email</span> }
                                </span>
                                @if (canEditGuests)
                                {
                                    <button type="button" class="guest-optional @(guest.Optional ? "on" : "")" aria-pressed="@guest.Optional"
                                            title="@(guest.Optional ? "Optional: click to make required" : "Required: click to make optional")"
                                            @onclick="() => ToggleOptional(guest)">@(guest.Optional ? "Optional" : "Required")</button>
                                    <button type="button" class="icon-btn small" title="Remove @guest.Display" @onclick="() => RemoveGuest(guest)"><Icon Name="x" Size="14" /></button>
                                }
                                else if (guest.Optional)
                                {
                                    <span class="muted">Optional</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            @if (canEditGuests && guests.Count > 0 && Senders.Count > 1 && !organizerFixed)
            {
                <div class="field">
                    <label for="ee-org">Invite as</label>
                    <select id="ee-org" @bind="organizerEmail">
                        @foreach (var s in Senders) { <option value="@s.Email">@s</option> }
                    </select>
                </div>
            }
            @if (canEditGuests && (guests.Count > 0 || initialGuests.Count > 0))
            {
                <label class="check-row">
                    <input type="checkbox" @bind="notifyGuests" /> Email @(Event == null || initialGuests.Count == 0 ? "invitations" : "changes") to guests
                </label>
            }

            <div class="field">
                <label for="ee-desc">Notes</label>
                <textarea id="ee-desc" rows="3" @bind="description" @bind:event="oninput"></textarea>
            </div>

            @if (error != null)
            {
                <div class="alert err" role="alert"><Icon Name="alert" Size="15" /><div>@error</div></div>
            }
        </div>

        <div class="modal-foot">
            @if (Event != null)
            {
                @if (confirmDelete)
                {
                    <span class="delete-confirm">
                        @if (canEditGuests && initialGuests.Count > 0 && notifyGuests)
                        {
                            <span class="muted">Guests will be told.</span>
                        }
                        @if (Event.IsRecurring)
                        {
                            <button type="button" class="btn danger small" @onclick="() => Delete(true)" disabled="@busy">This occurrence</button>
                            <button type="button" class="btn danger small" @onclick="() => Delete(false)" disabled="@busy">All occurrences</button>
                        }
                        else
                        {
                            <button type="button" class="btn danger small" @onclick="() => Delete(false)" disabled="@busy">Delete event</button>
                        }
                        <button type="button" class="btn ghost small" @onclick="() => confirmDelete = false">Keep</button>
                    </span>
                }
                else
                {
                    <button type="button" class="btn ghost danger" @onclick="() => confirmDelete = true" disabled="@busy"><Icon Name="trash" Size="15" /> Delete</button>
                }
            }
            <span class="spacer"></span>
            <button type="button" class="btn" @onclick="Cancel" disabled="@busy">Cancel</button>
            <button type="submit" class="btn accent" disabled="@busy">@if (busy) { <span class="spinner"></span> } Save</button>
        </div>
    </form>
</div>

@code {
    [Parameter] public CalendarEvent? Event { get; set; }
    [Parameter] public IReadOnlyList<CalendarInfo> Calendars { get; set; } = [];
    [Parameter] public Func<string?, string> ColorOf { get; set; } = _ => "var(--accent)";
    [Parameter] public string? DefaultCalendarId { get; set; }
    [Parameter] public DateOnly Day { get; set; }
    /// <summary>For a new event, the highlighted days (End is the last day) or times (End exclusive); overrides <see cref="Day"/>.</summary>
    [Parameter] public CalendarSlot? Slot { get; set; }
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;
    /// <summary>The user's addresses: who can organise a meeting, and how the editor knows it's theirs.</summary>
    [Parameter] public IReadOnlyList<SenderIdentity> Senders { get; set; } = [];
    /// <summary>Arguments: the edit, the calendar, and whether to email the guests. Returns an error message, or null when saved.</summary>
    [Parameter] public Func<EventEdit, string, bool, Task<string?>>? OnSave { get; set; }
    /// <summary>Arguments: true = only this occurrence; whether to email the guests. Returns an error message, or null.</summary>
    [Parameter] public Func<bool, bool, Task<string?>>? OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string summary = "", location = "", description = "", calendarId = "";
    private bool allDay, customRule, confirmDelete, busy;
    private DateOnly startDate, endDate;
    private TimeOnly startTime, endTime;
    private EventRepeat repeat;
    private string? error;
    private string initial = "";
    private ElementReference titleInput;

    // guests
    private List<EventAttendee> guests = new();
    private IReadOnlyList<EventAttendee> initialGuests = [];
    private string guestInput = "", organizerEmail = "";
    private string? guestError;
    private bool notifyGuests = true, canEditGuests = true, organizerFixed, candidatesRequested;
    private IReadOnlyList<RecipientCandidate>? candidates;

    // reminder: minutes before the start, or NoReminder
    private const int NoReminder = int.MinValue;
    private static readonly int[] StandardReminders = [0, 5, 10, 15, 30, 60, 120, 1440, 2880, 10080];
    private int reminder = NoReminder, initialReminder = NoReminder;
    private IReadOnlyList<int> initialReminders = [];

    /// <summary>The usual choices, plus the event's own reminder when it's something else.</summary>
    private IEnumerable<int> ReminderChoices =>
        initialReminder == NoReminder || StandardReminders.Contains(initialReminder)
            ? StandardReminders
            : StandardReminders.Append(initialReminder).Order();

    private static string ReminderLabel(int minutes) => minutes switch
    {
        0 => "When it starts",
        < 0 => $"{Span(-minutes)} after it starts",
        _ => $"{Span(minutes)} before",
    };

    private static string Span(int m) =>
        m % 10080 == 0 ? Plural(m / 10080, "week") : m % 1440 == 0 ? Plural(m / 1440, "day")
        : m % 60 == 0 ? Plural(m / 60, "hour") : Plural(m, "minute");

    private static string Plural(int n, string unit) => n == 1 ? $"1 {unit}" : $"{n} {unit}s";

    protected override async Task OnInitializedAsync()
    {
        calendarId = Event?.CalendarId ?? DefaultCalendarId ?? Calendars.FirstOrDefault()?.Id ?? "";
        organizerEmail = Senders.FirstOrDefault()?.Email ?? "";
        if (Event is { } ev)
        {
            guests = ev.Attendees.ToList();
            initialGuests = ev.Attendees;
            initialReminders = ev.Reminders;
            reminder = initialReminder = ev.Reminders.Count > 0 ? ev.Reminders[0] : NoReminder;
            if (ev.Organizer is { } org)
            {
                // A meeting someone else organises: its guest list is theirs.
                var mine = Senders.FirstOrDefault(s => s.Email.Equals(org.Email, StringComparison.OrdinalIgnoreCase));
                canEditGuests = mine != null;
                organizerFixed = true;
                if (mine != null) organizerEmail = mine.Email;
            }
            summary = ev.Summary == "(no title)" ? "" : ev.Summary;
            location = ev.Location ?? "";
            description = ev.Description ?? "";
            allDay = ev.AllDay;
            if (allDay)
            {
                startDate = DateOnly.FromDateTime(ev.Start.UtcDateTime);
                endDate = DateOnly.FromDateTime(ev.End.UtcDateTime).AddDays(-1); // stored end is exclusive
                if (endDate < startDate) endDate = startDate;
                startTime = new TimeOnly(9, 0);
                endTime = new TimeOnly(10, 0);
            }
            else
            {
                var s = TimeZoneInfo.ConvertTime(ev.Start, Zone).DateTime;
                var e = TimeZoneInfo.ConvertTime(ev.End, Zone).DateTime;
                (startDate, startTime) = (DateOnly.FromDateTime(s), TimeOnly.FromDateTime(s));
                (endDate, endTime) = (DateOnly.FromDateTime(e), TimeOnly.FromDateTime(e));
            }
            if (ev.IsRecurring)
            {
                // The instance doesn't carry the rule; read it from the series.
                try { repeat = await Dav.GetRepeatAsync(ev); } catch { repeat = EventRepeat.Weekly; }
                customRule = repeat == EventRepeat.None;
                if (customRule) repeat = EventRepeat.Weekly;
            }
        }
        else if (Slot is { } slot)
        {
            // New, for the days or times the user highlighted.
            allDay = slot.AllDay;
            startDate = DateOnly.FromDateTime(slot.Start);
            endDate = DateOnly.FromDateTime(slot.End);
            if (allDay)
            {
                startTime = new TimeOnly(9, 0);
                endTime = new TimeOnly(10, 0);
            }
            else
            {
                startTime = TimeOnly.FromDateTime(slot.Start);
                endTime = TimeOnly.FromDateTime(slot.End);
                // Up to midnight: end at 23:59 that day rather than 00:00 the next.
                if (slot.End.TimeOfDay == TimeSpan.Zero && slot.End > slot.Start) (endDate, endTime) = (endDate.AddDays(-1), new TimeOnly(23, 59));
            }
        }
        else
        {
            // New: the next whole hour today, otherwise 09:00 on the chosen day; one hour long.
            var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Zone).DateTime;
            var today = DateOnly.FromDateTime(now);
            var hour = Day == today ? Math.Min(now.Hour + 1, 23) : 9;
            startDate = endDate = Day;
            startTime = new TimeOnly(hour, 0);
            endTime = hour == 23 ? new TimeOnly(23, 59) : new TimeOnly(hour + 1, 0);
        }
        duration = EndValue - StartValue;
        if (duration < TimeSpan.Zero) duration = TimeSpan.Zero;
        initial = Snapshot();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) try { await titleInput.FocusAsync(); } catch { /* not attached */ }
    }

    private string Snapshot() => string.Join("|", summary, location, description, calendarId, allDay, startDate, startTime, endDate, endTime, repeat,
        string.Join(",", guests.Select(g => g.Email + g.Optional)), guestInput.Trim(), organizerEmail, reminder);

    private DateTime StartValue => startDate.ToDateTime(allDay ? TimeOnly.MinValue : startTime);
    private DateTime EndValue => endDate.ToDateTime(allDay ? TimeOnly.MinValue : endTime);

    /// <summary>Length kept when the start moves; updated whenever the end is edited.</summary>
    private TimeSpan duration = TimeSpan.FromHours(1);

    private void StartChanged()
    {
        var end = StartValue + duration;
        endDate = DateOnly.FromDateTime(end);
        if (!allDay) endTime = TimeOnly.FromDateTime(end);
    }

    private void EndChanged()
    {
        var length = EndValue - StartValue;
        if (length >= TimeSpan.Zero) duration = length;
    }

    private void AllDayChanged()
    {
        if (endDate < startDate) endDate = startDate;
        EndChanged();
    }

    // ---- guests ----

    private async Task LoadCandidates()
    {
        if (candidatesRequested) return;
        candidatesRequested = true;
        try
        {
            var list = await Dav.GetContactsAsync();
            if (list != null) candidates = RecipientSuggester.FromContacts(list.Contacts);
        }
        catch (Exception ex) when (ex is CalDavException or InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            // Suggestions are a convenience; typing addresses still works.
        }
    }

    /// <summary>Add the typed addresses to the guest list. False when one of them isn't an address.</summary>
    private bool AddGuests()
    {
        guestError = null;
        var bad = new List<string>();
        foreach (var a in MailFormat.ParseAddressList(guestInput))
        {
            var email = a.Email.Trim();
            if (!System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+$")) { bad.Add(a.ToString()); continue; }
            if (guests.Any(g => g.Email.Equals(email, StringComparison.OrdinalIgnoreCase))) continue;
            var earlier = initialGuests.FirstOrDefault(g => g.Email.Equals(email, StringComparison.OrdinalIgnoreCase));
            guests.Add(earlier ?? new EventAttendee(email, string.IsNullOrWhiteSpace(a.Name) ? null : a.Name.Trim()));
        }
        guestInput = string.Join(", ", bad);
        if (bad.Count > 0) guestError = bad.Count == 1 ? $"\"{bad[0]}\" isn't an email address." : "Some of these aren't email addresses.";
        return bad.Count == 0;
    }

    private void RemoveGuest(EventAttendee guest) => guests.Remove(guest);

    private void ToggleOptional(EventAttendee guest)
    {
        var i = guests.IndexOf(guest);
        if (i >= 0) guests[i] = guest with { Optional = !guest.Optional };
    }

    private async Task Save()
    {
        error = null;
        if (canEditGuests && !string.IsNullOrWhiteSpace(guestInput) && !AddGuests()) return;
        var organizer = Senders.FirstOrDefault(s => s.Email == organizerEmail);
        if (canEditGuests && guests.Count > 0 && organizer == null)
        {
            error = "Your email addresses couldn't be loaded, so guests can't be invited right now.";
            return;
        }
        var (start, end) = (StartValue, EndValue);
        if (end < start)
        {
            error = "The event ends before it starts.";
            return;
        }
        if (string.IsNullOrEmpty(calendarId))
        {
            error = "Choose a calendar.";
            return;
        }
        // Reminders are only rewritten when changed here, so ones this editor can't show are kept.
        IReadOnlyList<int>? reminders = reminder == initialReminder ? null : reminder == NoReminder ? [] : [reminder];
        var edit = new EventEdit(summary, location, description, allDay, start, end, repeat,
            canEditGuests ? guests : null, organizer, reminders);
        busy = true;
        try { if (OnSave != null) error = await OnSave(edit, calendarId, canEditGuests && notifyGuests); }
        finally { busy = false; }
    }

    private async Task Delete(bool onlyThis)
    {
        busy = true;
        try { if (OnDelete != null) error = await OnDelete(onlyThis, canEditGuests && notifyGuests); }
        finally { busy = false; }
    }

    private async Task Cancel()
    {
        if (Snapshot() != initial && !await JS.InvokeAsync<bool>("nullifyApp.confirm", "Discard your changes to this event?")) return;
        await OnClose.InvokeAsync();
    }
}
